@model IReadOnlyList<Produto>
<div class="row g-4">@foreach(var p in Model){<div class="col-md-4"><div class="card p-3"><h2 class="h4">@p.Nome</h2><p>@p.Descricao</p><strong>@p.Preco.ToString("C")</strong><a asp-action="Detalhes" asp-route-id="@p.ProdutoId">Detalhes</a></div></div>}</div>@if(Model.Count==0){<p>Nenhum produto encontrado.</p>}
