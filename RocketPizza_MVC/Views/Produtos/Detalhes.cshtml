@model Produto
@{ViewData["Title"]=Model.Nome;}
<section class="section"><div class="container"><div class="card p-4"><h1>@Model.Nome</h1><p>@Model.Descricao</p><div class="price">@Model.Preco.ToString("C")</div><a class="btn btn-danger mt-3" asp-controller="Pedidos" asp-action="Criar">Fazer pedido</a></div></div></section>
