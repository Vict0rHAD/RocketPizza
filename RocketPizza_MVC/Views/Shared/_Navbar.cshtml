@using RocketPizza.Extensions
@{var usuario=Context.Session.GetUsuario();}
<nav class="navbar navbar-expand-lg navbar-dark"><div class="container"><a class="navbar-brand logo" asp-controller="Home" asp-action="Index">🚀 Rocket Pizza</a><button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#menu"><span class="navbar-toggler-icon"></span></button><div id="menu" class="collapse navbar-collapse"><ul class="navbar-nav me-auto"><li><a class="nav-link" asp-controller="Home" asp-action="Index">Início</a></li><li><a class="nav-link" asp-controller="Produtos" asp-action="Index">Cardápio</a></li><li><a class="nav-link" asp-controller="Unidades" asp-action="Index">Unidades</a></li><li><a class="nav-link" asp-controller="Contato" asp-action="Index">Contato</a></li></ul><div class="d-flex gap-2 align-items-center">@if(usuario is null){<a class="btn btn-outline-light" asp-controller="Clientes" asp-action="Login">Entrar</a><a class="btn btn-warning" asp-controller="Clientes" asp-action="Cadastro">Cadastrar</a>}else{<span class="text-white">@usuario.Nome</span>@if(usuario.Perfil=="Administrador"){<a class="btn btn-warning" asp-controller="Administrador" asp-action="Dashboard">Administração</a>}else{<a class="btn btn-warning" asp-controller="Pedidos" asp-action="Criar">Pedir</a><a class="btn btn-outline-light" asp-controller="Pedidos" asp-action="MeusPedidos">Meus pedidos</a><a class="btn btn-outline-light" asp-controller="Perfil" asp-action="Index">Perfil</a>}<form asp-controller="Clientes" asp-action="Sair" method="post"><button class="btn btn-outline-light">Sair</button></form>}</div></div></div></nav>
