@model CriarPedidoViewModel
@{ViewData["Title"]="Criar pedido";var produtos=(IReadOnlyList<Produto>)ViewBag.Produtos;}
<div class="form-panel"><h1>Montar pedido</h1><form method="post"><div asp-validation-summary="ModelOnly"></div><label asp-for="Tamanho"></label><select asp-for="Tamanho" class="form-select mb-3"><option>Pequena</option><option>Media</option><option>Grande</option><option>Familia</option></select><label>Produto</label><select asp-for="ProdutoId" class="form-select mb-3"><option value="">Selecione</option>@foreach(var p in produtos){<option value="@p.ProdutoId">@p.Nome — @p.Preco.ToString("C")</option>}</select><label>Segundo sabor</label><select asp-for="SegundoProdutoId" class="form-select mb-3"><option value="">Nenhum</option>@foreach(var p in produtos){<option value="@p.ProdutoId">@p.Nome</option>}</select><label asp-for="Quantidade"></label><input asp-for="Quantidade" class="form-control mb-3"/><label asp-for="FormaPagamento"></label><select asp-for="FormaPagamento" class="form-select mb-3"><option>Pix</option><option>Cartao</option><option>Dinheiro</option></select><label asp-for="Observacoes"></label><textarea asp-for="Observacoes" class="form-control mb-3"></textarea><button class="btn btn-danger">Confirmar</button></form></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
