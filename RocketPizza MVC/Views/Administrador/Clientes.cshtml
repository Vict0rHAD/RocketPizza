@model IReadOnlyList<Cliente>
@{ViewData["Title"]="Administrar clientes";}<section class="section"><div class="container"><h1>Clientes</h1><div class="table-wrap"><table class="table"><thead><tr><th>Nome</th><th>E-mail</th><th>Telefone</th><th>Ativo</th><th>Ações</th></tr></thead><tbody>@foreach(var c in Model){<tr><td>@c.Nome</td><td>@c.Email</td><td>@c.Telefone</td><td>@(c.Ativo?"Sim":"Não")</td><td class="d-flex gap-2"><form asp-action="AlternarCliente" method="post"><input name="id" value="@c.ClienteId" type="hidden"/><button class="btn btn-sm btn-outline-secondary">Alternar</button></form><form asp-action="ExcluirCliente" method="post"><input name="id" value="@c.ClienteId" type="hidden"/><button class="btn btn-sm btn-outline-danger">Excluir</button></form></td></tr>}</tbody></table></div></div></section>
