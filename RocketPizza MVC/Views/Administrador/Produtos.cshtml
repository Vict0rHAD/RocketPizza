@model IReadOnlyList<Produto>
@{ViewData["Title"]="Administrar produtos";}<section class="section"><div class="container"><h1>Produtos</h1><div class="card p-3 mb-4"><form asp-action="SalvarProduto" method="post" class="row g-2"><div class="col"><input name="CategoriaId" type="number" min="1" class="form-control" placeholder="Categoria ID" required/></div><div class="col"><input name="Nome" class="form-control" placeholder="Nome" required/></div><div class="col"><input name="Descricao" class="form-control" placeholder="Descrição" required/></div><div class="col"><input name="Preco" type="number" step=".01" class="form-control" placeholder="Preço" required/></div><input name="Ativo" value="true" type="hidden"/><div class="col"><button class="btn btn-danger">Criar</button></div></form></div><div class="table-wrap"><table class="table"><thead><tr><th>Categoria</th><th>Nome</th><th>Preço</th><th>Ativo</th><th></th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.Categoria</td><td>@p.Nome</td><td>@p.Preco.ToString("C")</td><td>@(p.Ativo?"Sim":"Não")</td><td><form asp-action="ExcluirProduto" method="post"><input name="id" value="@p.ProdutoId" type="hidden"/><button class="btn btn-sm btn-outline-danger">Remover</button></form></td></tr>}</tbody></table></div></div></section>
