@model IReadOnlyList<Pedido>
@{ViewData["Title"]="Administrar pedidos";}<section class="section"><div class="container"><h1>Pedidos</h1><div class="table-wrap"><table class="table"><thead><tr><th>Nº</th><th>Cliente</th><th>Total</th><th>Status</th></tr></thead><tbody>@foreach(var p in Model){<tr><td>#@p.PedidoId</td><td>@p.Cliente</td><td>@p.Total.ToString("C")</td><td><form asp-action="Status" method="post" class="d-flex"><input name="id" value="@p.PedidoId" type="hidden"/><select name="status" class="form-select">@foreach(var s in new[]{"Recebido","Preparando","SaiuEntrega","Concluido","Cancelado"}){<option selected="@(s==p.Status)">@s</option>}</select><button class="btn btn-danger">Salvar</button></form></td></tr>}</tbody></table></div></div></section>
